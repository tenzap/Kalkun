[kalkun-snapshots]
fqdn = ppa.launchpad.net
method = sftp
incoming = ~%LAUNCHPAD_USER_NAME%/ubuntu/kalkun-snapshots
login = bastif
allow_unsigned_uploads = 0

[kalkun-releases]
fqdn = ppa.launchpad.net
method = sftp
incoming = ~%LAUNCHPAD_USER_NAME%/ubuntu/kalkun-releases
login = bastif
allow_unsigned_uploads = 0

[kalkun-build-deps]
fqdn = ppa.launchpad.net
method = sftp
incoming = ~%LAUNCHPAD_USER_NAME%/ubuntu/kalkun-build-deps
login = bastif
allow_unsigned_uploads = 0
